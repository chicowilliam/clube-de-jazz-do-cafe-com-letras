{
 "sub-p": "<p style=\"margin: 16px 0 0; font-size: 28px; color: #EFADFF; font-family: 'Playfair Display', Georgia, serif; font-style: italic\">{{text}}</p>",
 "lead-p": "<p style=\"margin: 0; font-size: 22px; line-height: 1.6; color: #F2ECE1\">{{text}}</p>",
 "desc-p": "<p style=\"margin: 24px 0 0; font-size: 17px; line-height: 1.7; color: #D9D1C4\">{{text}}</p>",
 "formation-item": "<div style=\"padding: 16px 0; border-top: 1px solid rgba(242,236,225,0.12)\"><p style=\"margin: 0; font-size: 18px; font-weight: 600\">{{name}}</p><p style=\"margin: 4px 0 0; color: #B9B0A3\">{{role}}</p></div>",
 "formation-h2": "<h2 style=\"margin: 56px 0 16px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: #B9B0A3; font-weight: 600\">Formação</h2>",
 "formation-grid-open": "<div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 0 32px\">",
 "video-block": "<h2 style=\"margin: 56px 0 16px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: #B9B0A3; font-weight: 600\">Assista</h2>\n<a href=\"https://www.youtube.com/watch?v={{youtube}}\" rel=\"noopener\" style=\"display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 9; background: #2A2622; border-radius: 12px; position: relative; overflow: hidden; text-decoration: none\" target=\"_blank\">\n<svg aria-hidden=\"true\" style=\"position: relative\" height=\"72\" viewbox=\"0 0 56 56\" width=\"72\"><circle cx=\"28\" cy=\"28\" fill=\"none\" r=\"27\" stroke=\"#F2ECE1\" stroke-width=\"1.5\"></circle><path d=\"M23 19 L38 28 L23 37 Z\" fill=\"#F2ECE1\"></path></svg>\n<img src=\"https://i.ytimg.com/vi/{{youtube}}/hqdefault.jpg\" alt=\"Vídeo de {{title_attr}} no YouTube\" loading=\"lazy\" decoding=\"async\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: inherit\"/>\n</a>",
 "bomsaber-block": "<h2 style=\"margin: 56px 0 16px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: #B9B0A3; font-weight: 600\">Bom saber</h2>\n<div style=\"display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.6; color: #D9D1C4\">\n<p style=\"margin: 0\">As vendas antecipadas se encerram no início do show ou quando a área interna lota. Depois disso, só na porta.</p>\n<p style=\"margin: 0\">Ingressos não validados até 30 minutos após o início do show liberam a mesa para a lista de espera. Chegue cedo.</p>\n<p style=\"margin: 0\">Na varanda não há venda antecipada: é só chegar.</p>\n</div>",
 "aside-row": "<div style=\"display: flex; justify-content: space-between; padding: 12px 0; border-top: 1px solid rgba(242,236,225,0.12)\"><span style=\"color: #B9B0A3\">{{label}}</span><span>{{value}}</span></div>",
 "aside-row-last": "<div style=\"display: flex; justify-content: space-between; padding: 12px 0; border-top: 1px solid rgba(242,236,225,0.12); border-bottom: 1px solid rgba(242,236,225,0.12)\"><span style=\"color: #B9B0A3\">{{label}}</span><span>{{value}}</span></div>",
 "more-card": "<a href=\"{{url}}\" style=\"display: block; padding: 24px; border-radius: 12px; background: #181614; color: #F2ECE1; text-decoration: none; border: 1px solid rgba(242,236,225,0.08)\"><p style=\"margin: 0; font-size: 13px; color: #DEAC00; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase\">{{day}}</p><p style=\"margin: 10px 0 0; font-family: 'Sharp Grotesk', Inter, sans-serif; text-transform: uppercase; letter-spacing: 0.01em; font-size: 17px; line-height: 1.1\">{{title}}</p></a>"
}