# Copie para .env (local) ou cadastre em Cloudflare Pages > Settings > Environment variables.
# NUNCA faça commit do arquivo .env com valores reais.

# --- Build (lidas por scripts/build.mjs) ---
# URL pública usada em canonical, Open Graph, sitemap e JSON-LD. Em preview, use a URL *.pages.dev.
SITE_URL=https://clubedejazzdocafe.com
# Token do Cloudflare Web Analytics (opcional). Vazio = sem analytics.
CF_WEB_ANALYTICS_TOKEN=
# Data "de hoje" para filtrar a agenda (AAAA-MM-DD). Vazio = data atual em America/Sao_Paulo.
BUILD_DATE=

# --- Runtime (lidas por functions/api/forms.js) ---
# Webhook que recebe os formulários (Make, Zapier, Apps Script, CRM...). Vazio = formulários respondem "envio ainda não ativo".
FORMS_WEBHOOK_URL=
# Segredo opcional enviado no cabeçalho X-Clube-Secret.
FORMS_WEBHOOK_SECRET=
# Origens aceitas, separadas por vírgula (opcional).
ALLOWED_ORIGINS=https://clubedejazzdocafe.com
